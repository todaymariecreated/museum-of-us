# Copy this file's variable NAMES into Vercel → Project → Settings → Environment Variables.
# Never commit real values to git or paste them into chat — set them directly in Vercel's dashboard.

# Supabase → Project Settings → API → "Project URL"
SUPABASE_URL=

# Supabase → Project Settings → API → "service_role" secret key (NOT the anon/public key)
SUPABASE_SERVICE_ROLE_KEY=
